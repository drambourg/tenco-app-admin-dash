{
  "author": "D. Rambourg",
  "dependencies": {
    "@bull-board/api": "^5.8.4",
    "@bull-board/express": "^5.8.4",
    "@faker-js/faker": "^8.3.1",
    "@google-cloud/functions-framework": "^3.1.0",
    "@google-cloud/logging": "^11.0.0",
    "@google-cloud/pubsub": "^4.0.0",
    "@turf/turf": "^7.2.0",
    "axios": "^1.6.0",
    "body-parser": "^1.20.3",
    "bull": "^4.12.2",
    "dotenv": "^16.4.4",
    "envalid": "^7.3.1",
    "express": "^4.18.2",
    "geolib": "^3.3.4",
    "ioredis": "^5.6.1",
    "mqtt": "^5.13.1",
    "redis-commander": "^0.9.0",
    "reflect-metadata": "^0.1.13",
    "turf": "^3.0.14"
  },
  "description": "Tenco App Dashboard and tools",
  "devDependencies": {
    "@babel/cli": "^7.27.2",
    "@babel/core": "^7.27.1",
    "@babel/node": "^7.27.1",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.27.1",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-typescript": "^7.27.1",
    "@commitlint/cli": "^16.1.0",
    "@commitlint/config-conventional": "^16.0.0",
    "@types/bull": "^4.10.0",
    "@types/express": "^4.17.17",
    "@typescript-eslint/eslint-plugin": "^5.59.9",
    "@typescript-eslint/parser": "^5.60.1",
    "babel-plugin-transform-typescript-metadata": "^0.3.2",
    "babel-watch": "^7.8.1",
    "copyfiles": "^2.4.1",
    "cspell": "^5.18.4",
    "cspell-dict-fr-fr": "^1.3.1",
    "dotenv-cli": "^7.4.4",
    "eslint": "^8.42.0",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-import-resolver-typescript": "^3.5.5",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsonc": "^2.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-sort-destructure-keys": "^1.4.0",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "eslint-plugin-typescript": "^0.14.0",
    "husky": "^7.0.4",
    "import-sort-style-module": "^6.0.0",
    "lint-staged": "^12.3.3",
    "prettier": "^2.5.1",
    "prettier-plugin-import-sort": "0.0.7",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.1",
    "typescript": "<5.1.0",
    "typescript-eslint-parser": "^22.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "importSort": {
    ".js, .jsx, .ts, .tsx": {
      "style": "module"
    }
  },
  "license": "ISC",
  "lint-staged": {
    "*": "cspell src/index.ts",
    "*.{js,json,ts}": "eslint --cache --fix --max-warnings=0"
  },
  "name": "admin-app-tenco",
  "scripts": {
    "build": "npm run clean && copyfiles  \"tsconfig.json\" dist && tsc --project tsconfig.json && copyfiles -a -u 1 -e \"**/*.ts\" \"src/**/*\" dist && copyfiles  \"package.json\" dist",
    "clean": "rimraf dist",
    "husky:prepare": "husky install",
    "lint": "eslint src/ --max-warnings=0 && tsc --noemit",
    "lint:commit": "commitlint --verbose",
    "lint:fix": "eslint  src/ --fix",
    "pre-commit": "lint-staged",
    "print-stuff": "dotenv  -e .env -- npm run _print-stuff",
    "start": "npm run build && node dist/index.js",
    "start:dev": "GOOGLE_APPLICATION_CREDENTIALS=\"./.gcp/gcp-account-service.private.key.json\" npx dotenv-cli -e .env nodemon --watch src --ext ts,js --exec babel-node --extensions '.ts,.js' src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "version": "1.0.0"
}
